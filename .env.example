NODE_ENV=development
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
FORCE_MARKET_OPEN=false
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
POSTGRES_ENABLED=true
DATABASE_URL=postgresql://market_watch:market_watch@localhost:5432/market_watch

# Backend-only market data source. Angel One credentials are server-side only
# and must never be given a NEXT_PUBLIC_ prefix.
# Required when MARKET_DATA_PROVIDER=angelone:
MARKET_DATA_PROVIDER=mock
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PASSWORD=
ANGELONE_TOTP_SECRET=
# Optional login headers. Static IP is only mandatory for Order/GTT APIs, not
# for login, REST market data, or the WebSocket feed.
ANGELONE_MAC_ADDRESS=
ANGELONE_CLIENT_LOCAL_IP=
ANGELONE_CLIENT_PUBLIC_IP=
ANGELONE_BASE_URL=https://apiconnect.angelone.in
ANGELONE_WEBSOCKET_URL=wss://smartapisocket.angelone.in/smart-stream
ANGELONE_SUBSCRIPTION_MODE=2
